<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SAPS_ICMS</title>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    @* <link rel="stylesheet" href="~/css/SAPS_ICMS.styles.css" asp-append-version="true" /> *@
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@
    <style>

        body {
            padding-top: 60px;
        }
        h2, h3{
            padding-top:60px;
        }
        :root {
            --saps-blue: #003366;
            --saps-gold: #FFD700;
            --saps-light: #f8f9fa;
        }

        .welcome-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: var(--saps-light);
            text-align: center;
            padding: 20px;
        }

        .welcome-logo {
            height: 130px;
            margin-bottom: 20px;
        }

        .welcome-title {
            color: var(--saps-blue);
            font-weight: 700;
            margin-bottom: 10px;
        }

        .welcome-tagline {
            color: #6c757d;
            font-size: 1.25rem;
            margin-bottom: 25px;
        }

        .welcome-buttons .btn-login {
            background-color: var(--saps-blue);
            color: white;
            font-size: 1.1rem;
            padding: 10px 25px;
            border: 2px solid black;
            display: inline-block;
            border-radius: 8px;
            margin: 5px;
        }

            .welcome-buttons .btn-login:hover {
                background-color: #002244;
            }

        .welcome-buttons .btn-register {
            background-color: var(--saps-gold);
            color: black;
            font-size: 1.1rem;
            padding: 10px 25px;
            border: 2px solid black;
            display: inline-block;
            border-radius: 8px;
            margin: 5px;
        }

        .welcome-buttons .btn-login:hover {
            background-color: #e6c200;
        }

        .welcome-footer {
            margin-top: 40px;
            font-size: 0.9rem;
            color: #6c757d;
        }

        .statement {
            padding: 20px;
            background: #f9f9f9;
            border-radius: 8px;
            border: 1px solid #ccc;
        }

            .statement h4 {
                margin-top: 20px;
                color: #003366;
            }

        blockquote {
            font-style: italic;
            background: #eef5ff;
            padding: 10px;
            border-left: 5px solid #003366;
        }

        body {
            margin: 0;
            padding: 0;
        }
        .image{

        }
        ul {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            list-style-type: none;
            margin: 0;
            padding: 0;
            display: flex;
            overflow: visible;
            transition: all 0.3s ease;
            background-color: #003366;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
        .ul-content{
            list-style-type: none;
            margin: 0;
            padding: 0;
            display: flex;
            overflow: hidden;
            transition: all 0.3s ease;
            background-color: cornflowerblue;
        }

            ul li {
                float: left;
            }

                ul li a, dropbtn {
                    display: inline-block;
                    color: white;
                    text-align: center;
                    padding: 14px 16px;
                    text-decoration: none;
                }

                    ul li a:hover:not(.active) {
                        background-color: cornflowerblue;
                    }

                    ul li a.active {
                        background-color:cornflowerblue;
                    }
                    i{
                        color:white;
                    }
        
                    li.dropdown{
            display: inline-block;
        }

        li.dropdown-right{
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 1001;
        }

            .dropdown-content a {
                color: black;
                padding: 12px 16px;
                text-decoration: none;
                display: block;
                text-align: left;
            }

                .dropdown-content a:hover {
                    background-color: #f1f1f1;
                }

        .dropdown:hover .dropdown-content {
            display: block;
        }
        .logout{
            margin-left: auto;
        }

        glyphicon {
            font-size: 60px;
        }
        th, td {
            width: 50%;
            height: 70px;
            padding: 10px;
            border: 1px solid;
        }
        table{
            border-collapse: collapse;
        }

        .tab {
            overflow: hidden;
            border: 1px solid #003366;
            background-color: #f1f1f1;
        }

            .tab button {
                background-color: inherit;
                float: left;
                border: none;
                outline: none;
                cursor: pointer;
                padding: 14px 16px;
                transition: 0.3s;
                font-size: 17px;
            }

                .tab button:hover {
                    background-color: #ddd;
                }

                .tab button.active {
                    background-color: #ccc;
                }

        .dashboard-cards {
            display: flex;
            gap: 20px;
            justify-content: center;
        }

        form {
            border-radius: 5px;
            background-color: #f2f2f2;
            padding: 20px;
        }

        label {
            display: block;
        }

        input[type=text], select {
            width: 100%;
            padding: 12px;
            margin: 8px 0;
            display: inline-block;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        input[type=submit], input[type=button] {
            width: 100%;
            background-color: cornflowerblue;
            color: white;
            padding: 14px;
            margin: 4px 2px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        .success-banner {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background-color: cornflowerblue; 
            color: white;
            padding: 15px 25px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            font-size: 16px;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-width: 300px;
        }

            .success-banner .close-btn {
                margin-left: 15px;
                font-size: 20px;
                font-weight: bold;
                cursor: pointer;
            }

        .confirm-container {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .confirm-content {
            background: #fff;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            width: 300px;
            box-shadow: 0px 4px 8px rgba(0,0,0,0.2);
        }

            .confirm-content button {
                margin: 5px;
            }
        
        .home-welcome {
            background: linear-gradient(90deg, #004aad, #0073e6);
            color: white;
            padding: 20px 30px;
            border-radius: 10px;
            margin-bottom: 25px;
        }

            .home-welcome h2 {
                margin: 0;
                font-size: 1.6rem;
            }

            .home-welcome p {
                margin: 5px 0 0;
                font-size: 0.95rem;
            }

        
        .home-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .home-section {
            background: #fff;
            border-radius: 10px;
            padding: 15px 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

            .home-section h3 {
                margin-top: 0;
                font-size: 1.1rem;
                margin-bottom: 10px;
                color: #004aad;
            }

            
            .home-section ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .home-section li {
                padding: 5px 0;
                border-bottom: 1px solid #eee;
                font-size: 0.9rem;
            }

                .home-section li:last-child {
                    border-bottom: none;
                }

        .view-all {
            display: inline-block;
            margin-top: 10px;
            font-size: 0.85rem;
            color: #004aad;
            text-decoration: none;
        }

            .view-all:hover {
                text-decoration: underline;
            }

        
        .actions-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 10px;
        }

        .action-btn {
            display: inline-block;
            text-align: center;
            background: #004aad;
            color: white;
            padding: 10px;
            border-radius: 6px;
            font-size: 0.9rem;
            text-decoration: none;
            transition: background 0.2s;
        }

            .action-btn:hover {
                background: #003380;
            }

        
        .home-bottom {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 20px;
        }

        .announcements p {
            font-size: 0.9rem;
            margin-bottom: 5px;
        }

        .resources ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .resources li a {
            text-decoration: none;
            color: #004aad;
            font-size: 0.9rem;
        }

            .resources li a:hover {
                text-decoration: underline;
            }

        
        .admin-widget {
            background: #f8f8f8;
            border-left: 4px solid #004aad;
        }

        .admin-link {
            display: inline-block;
            margin-top: 8px;
            color: #004aad;
            font-weight: 600;
            text-decoration: none;
        }

            .admin-link:hover {
                text-decoration: underline;
            }

        {
            grid-template-columns: 1fr;
        }

        .home-bottom {
            grid-template-columns: 1fr;
        }

        }
        
        .help-header {
            background: linear-gradient(90deg, #004aad, #0073e6);
            color: white;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 25px;
        }

            .help-header h2 {
                margin: 0 0 10px;
                font-size: 1.8rem;
            }

            .help-header p {
                margin: 0;
                font-size: 1rem;
            }

        
        .help-toc {
            background: #f8f8f8;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 30px;
        }

            .help-toc ul {
                display: flex;
                flex-wrap: wrap;
                gap: 15px;
                list-style: none;
                margin: 0;
                padding: 0;
            }

            .help-toc a {
                text-decoration: none;
                color: white;
                font-weight: 500;
                font-size: 0.95rem;
            }

                .help-toc a:hover {
                    text-decoration: underline;
                }

        
        .help-section {
            margin-bottom: 35px;
            background: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        }

            .help-section h3 {
                color: #004aad;
                margin-top: 0;
                font-size: 1.2rem;
                margin-bottom: 15px;
            }

            .help-section ul{
                margin: 0;
                padding-left: 20px;
                font-size: 0.95rem;
                color: white;
            }
            .help-section ol {
                margin: 0;
                padding-left: 20px;
                font-size: 0.95rem;
            }

            .help-section li {
                margin-bottom: 8px;
                color: black;
            }

            .help-section p {
                font-size: 0.95rem;
            }

            .help-section details {
                margin-bottom: 10px;
                background: #f4f4f4;
                padding: 10px 15px;
                border-radius: 6px;
                cursor: pointer;
            }

            .help-section summary {
                font-weight: 600;
                color: #004aad;
            }

            .help-section details[open] {
                background: #e9f1ff;
            }

        .report-problem-btn {
            display: inline-block;
            margin-top: 10px;
            background: #004aad;
            color: white;
            padding: 10px 15px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.9rem;
            transition: background 0.2s;
        }

            .report-problem-btn:hover {
                background: #003380;
            }

            flex-direction: column{
        }

        .form-control:focus {
            outline: none;
            border-color: #2c3e50;
            box-shadow: 0 0 5px rgba(44, 62, 80, 0.3);
        }

        button:hover {
            background-color: #34495e !important;
            transform: translateY(-2px);
            transition: all 0.2s;
        }
    </style>
</head>
<body>
    <ul>
        <li class="dropdown"><a asp-controller="Home" asp-action="Index" class="dropbtn">Home</a>
            <div class="dropdown-content">
                <a asp-controller="Pages" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="Pages" asp-action="Tasks">Tasks</a>
                <a asp-controller="Pages" asp-action="Calendar">Calendar</a>
            </div>
        </li>
        <li><a asp-controller="Cases" asp-action="Create">New Case</a></li>
        @if(User.IsInRole("Admin"))
        {
            <li class="dropdown"><a asp-controller="Cases" asp-action="Index">Cases</a>
                <div class="dropdown-content">
                    <a href="@Url.Action("CasesByLocation", "Pages")">Cases by Location</a>
                </div>
            </li>
        }
        else
        {
            <li class="dropdown"><a asp-controller="Cases" asp-action="Index">My Cases</a>
            <div class="dropdown-content">
                    <a href="@Url.Action("MyApprovedEditRequests", "Pages")">Approved Edits</a>
            </div>
            </li>
        }
        <li><a asp-controller="Evidence" asp-action="Index">Evidence</a></li>
        <li><a asp-controller="Pages" asp-action="Archive">Archive</a></li>
        @if (User.IsInRole("Admin"))
        {
            <li class="dropdown">
                <a asp-controller="Pages" asp-action="ActivityLog">Activity Log</a>
            </li>
        }
        <li class="logout"><a asp-controller="Account" asp-action="Logout" method="post">Logout</a></li>
    </ul>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    @* <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script> *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

