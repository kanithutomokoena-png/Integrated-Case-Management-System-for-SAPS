@model List<SAPS_ICMS.Models.Case>
@{
    ViewData["Title"] = "Cases by Location";
    var locations = ViewBag.Locations as List<string>;
    var selectedLocation = ViewBag.SelectedLocation as string;
    var groupedCases = Model.GroupBy(c => c.LocationTaken).OrderBy(g => g.Key);
}

<div class="tabcontent">
    <h3>Cases by Location</h3>

    <div style="margin-bottom: 30px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
        <span style="font-weight: bold;">Filter by Location:</span>
        <a href="@Url.Action("CasesByLocation")"
           class="location-filter @(string.IsNullOrEmpty(selectedLocation) ? "active" : "")"
           style="padding: 8px 16px; background-color: @(string.IsNullOrEmpty(selectedLocation) ? "#2196F3" : "#f0f0f0");
                  color: @(string.IsNullOrEmpty(selectedLocation) ? "white" : "#333");
                  text-decoration: none; border-radius: 20px; font-size: 14px;">
            All Locations
        </a>
        @foreach (var loc in locations)
        {
            <a href="@Url.Action("CasesByLocation", new { location = loc })"
               class="location-filter @(selectedLocation == loc ? "active" : "")"
               style="padding: 8px 16px; background-color: @(selectedLocation == loc ? "#2196F3" : "#f0f0f0");
                          color: @(selectedLocation == loc ? "white" : "#333");
                          text-decoration: none; border-radius: 20px; font-size: 14px;">
                @loc
            </a>
        }
    </div>

    @if(!Model.Any())
    {
        <div style="background:#f0f0f0; padding:30px; text-align:center; border-radius:10px;">
            <p style="font-size:18px; color: #666;">No cases found</p>
        </div>
    }
    else if(!string.IsNullOrEmpty(selectedLocation))
    {
        <div class="location-section" style="margin-bottom:30px">
            <h4 style="background:#2196F3; color:white; padding: 15px; border-radius:5px; margin-bottom:15px;">
                @selectedLocation
                <span style="float:right; font-size: 14px; font-weight:normal;">
                    @Model.Count
                    case@(Model.Count!=1?"s":"")
                </span>
            </h4>

            <table border="1" cellpadding="5" style="width:100%; border-collapse:collapse;">
                <thead>
                    <tr style="background-color:#f2f2f2;">
                        <th>Case ID</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Officer</th>
                        <th>Complainant</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var c in Model)
                    {
                        <tr>
                            <td>@c.CaseId</td>
                            <td>@c.Date.ToString("dd/MMM/yyyy")</td>
                            <td>
                                <span style="padding:4px 8px; background-color:@(c.Status == CaseStatus.Closed? "#c8e6c9" : "#fff3cd"); border-radius:4px;">@c.Status</span>
                            </td>
                            <td>@(c.OfficerTakingStatement?? "N/A")</td>
                            <td>@(c.Complainant?? "N/A")</td>
                            <td><a href="@Url.Action("Details", "Cases", new {id = c.CaseId})" style="padding:6px 12px; background-color:#2196F3; color:white; text-decoration:none; border-radius:4px; display:inline-block;">View Details</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    else
        {
            @foreach(var locationGroup in groupedCases)
            {
                <div class="location-section" style="margin-bottom:40px;">
                    <h4 style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color:white; padding:15px; border-radius:5px; margin-bottom:15px; cursor: pointer;" onclick="toggleSection('section-@locationGroup.Key.Replace(" ", "-")')">
                    @locationGroup.Key <span style="float:right; font-size:14px; font-weight:normal;">
                        @locationGroup.Count()
                        <span id="arrow-@locationGroup.Key.Replace(" ", "-")">▼</span>
                    </span>
                    </h4>
                    <div id="section-@locationGroup.Key.Replace(" ", "-")" class="location-content">
                        <div style="display:flex; gap:15px; margin-bottom:15px; flex-wrap:wrap;">
                            <div style="flex: 1; min-width:150px; background:#e3f2fd; padding:15px; border-radius:8px; text-align: center;">
                                <div style="font-size: 24px; font-weight:bold; color:#1976d2;">
                                    @locationGroup.Count(c => c.Status == CaseStatus.Investigation)
                                </div>
                                <div style="font-size:12px; color:#666;">
                                    Under Investigation
                                </div>
                            </div>
                            <div style="flex:1; min-width:150px; background:#fff3e0; padding:15px; border-radius:8px; text-align:center;">
                                <div style="font-size: 24px; font-weight: bold; color: #f57c00;">
                                    @locationGroup.Count(c => c.Status == CaseStatus.UnderReview)
                                </div>
                                <div style="font-size:12px; color:#666;">
                                    Under Review
                                </div>
                            </div>
                            <div style="flex:1; min-width:150px; background:#e8f5e9; padding:15px; border-radius:8px; text-align:center;">
                                <div style="font-size:24px; font-weight: bold; color: #388e3c;">
                                    @locationGroup.Count(c => c.Status == CaseStatus.Closed)
                                </div>
                                <div style="font-size:12px; color:#666;">
                                    Closed
                                </div>
                            </div>
                        </div>
                    <table border="1" cellpadding="5" style="width:100%; border-collapse:collapse; margin-top:10px;">
                        <thead>
                            <tr style="background-color:#f2f2f2;">
                                <th>Case ID</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Officer</th>
                                <th>Complainant</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in locationGroup.OrderByDescending(x => x.Date))
                            {
                                <tr>
                                    <td>
                                        @c.CaseId
                                    </td>
                                    <td>
                                        @c.Date.ToString("dd MM yyyy")
                                    </td>
                                    <td>
                                        <span style="padding:4px 8px; background-color:@(c.Status == CaseStatus.Closed ? "#c8e6c9" : c.Status == CaseStatus.UnderReview ? "#fff3cd" : "#e3f2fd"); border-radius:4px;">
                                            @c.Status
                                        </span>
                                    </td>
                                    <td>
                                        @(c.OfficerTakingStatement ?? "N/A")
                                    </td>
                                    <td>
                                        @(c.Complainant ?? "N/A")
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", "Cases", new { id = c.CaseId })" style="padding:6px 12px; background-color:#2196F3; color:white; text-decoration:none; border-radius:4px; display:inline-block;">View Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            }
    }
</div>

<script>
    function toggleSection(sectionId) {
        const content = document.getElementById(sectionId);
        const arrow = document.getElementById('arrow-' + sectionId.replace('section-', ''));

        if (content.style.display === 'none') {
            content.style.display = 'block';
            arrow.textContent = '▼';
        } else {
            content.style.display = 'none';
            arrow.textContent = '▶';
        }
    }
</script>
