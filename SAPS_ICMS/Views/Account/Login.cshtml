@{
    ViewData["Title"] = "Login";
}

<div class="welcome-container">
    <img src="https://seeklogo.com/images/S/south-african-police-service-logo-6BDCE827FF-seeklogo.com.png" alt="SAPS Logo" style="height:130px;" />
<h2>Officer Login</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
<br />
<form asp-action="Login" method="post">
    <div class="mb-3">
        <label>Security Number</label>
        <input type="text" name="securityNumber" class="form-control" required />
    </div>
    <br />
    <div>
        <label>Password</label>
        <input type="password" name="password" class="form-control" required />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Login</button>
        <br />
        <a asp-controller="Account" asp-action="Register" class="btn btn-lg btn-success m-2">
            Haven't Registered? Register here
        </a>
</form>
</div>

