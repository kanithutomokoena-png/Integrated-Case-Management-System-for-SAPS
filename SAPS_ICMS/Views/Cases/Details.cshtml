@model SAPS_ICMS.Models.Case
@{
    ViewData["Title"] = "Case Details";
    var evidenceList = ViewBag.EvidenceList as List<SAPS_ICMS.Models.Evidence>;
}

    <div class="case-details" style="margin-left:130px; padding:1px 16px; height:1000px;">
       <div style="background: #f8f9fa; padding: 20px; border-left: 5px solid #007bff; margin-bottom: 20px;">
        <h2>Case #@Model.CaseNumber</h2>
        <p style="color: #666;">Case ID: @Model.CaseId</p>
       </div>
       <hr />
        <h2 class="text-center">Police Statement</h2>
        <hr />

        <div class="statement">

            <h4>1. Header Information</h4>
            <p><strong>Date:</strong> @Model.Date.ToString("dd-MM-yyyy")</p>
            <p><strong>Location Taken:</strong> @Model.LocationTaken</p>
            <p><strong>Officer Taking Statement:</strong> @Model.OfficerTakingStatement</p>
            <p><strong>Status:</strong> @Model.Status</p>

            <hr />


            <h4>2. Person Details</h4>
            <p><strong>Complainant:</strong> @Model.Complainant</p>
            <p><strong>Date of Birth:</strong> @Model.DateOfBirth?.ToString("dd-MM-yyyy")</p>
            <p><strong>Home Address:</strong> @Model.HomeAddress</p>
            <p><strong>Phone Number:</strong> @Model.PhoneNumber</p>
            <p><strong>Occupation:</strong> @Model.Occupation</p>
            <p><strong>Relationship to Incident:</strong> @Model.RelationshipToIncident</p>

            <hr />

        <h4>2b. Witnesses</h4>
        @if (Model.Witnesses != null && Model.Witnesses.Any())
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Statement</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var witness in Model.Witnesses)
                    {
                        <tr>
                            <td>@witness.Name</td>
                            <td>@witness.PhoneNumber</td>
                            <td>@witness.Statement</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No witnesses recorded for this case.</p>
        }
        <hr />

            <h4>3. Caution or Legal Disclaimer</h4>
            <blockquote>
                "You do not have to say anything, but it may harm your defense if you do not mention when questioned something
                which you rely on in court. Anything you do say may be given in evidence."
            </blockquote>

            <hr />


            <h4>4. Statement Body</h4>
            <p>@Model.CaseInformation</p>

            <hr />


            <h4>5. Declaration and Signatures</h4>
            <p>
                I confirm that this statement is true to the best of my knowledge and belief.
                I understand that it may be used as evidence in court.
            </p>

            <div class="row">
                <div class="col-md-6">
                    <h5>Complainant Signature</h5>
                    <p><strong>Name:</strong> @Model.Complainant</p>
                    <p><strong>Signature:</strong> @Model.ComplainantSignature</p>
                    <p><strong>Date:</strong> @(Model.ComplainantSignatureDate?.ToString("yyyy-MM-dd") ?? "N/A")</p>
                    <p><strong>Time:</strong> @(Model.ComplainantSignatureTime?.ToString(@"hh\:mm") ?? "N/A")</p>
                </div>

                <div class="col-md-6">
                    <h5>Officer Signature</h5>
                    <p><strong>Name:</strong> @Model.OfficerTakingStatement</p>
                    <p><strong>Signature:</strong> @Model.OfficerSignature</p>
                    <p><strong>Date:</strong> @(Model.OfficerSignatureDate?.ToString("yyyy-MM-dd") ?? "N/A")</p>
                </div>
            </div>
            <h3>Evidence</h3>

            @if (evidenceList != null && evidenceList.Count > 0)
            {
                <table>
                    <thead>
                        <tr>
                            <th>File Name</th>
                            <th>Uploaded By</th>
                            <th>Upload Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in evidenceList)
                        {
                            <tr>
                                <td>@ev.FileName</td>
                                <td>@ev.UploadedBy</td>
                                <td>@ev.UploadDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <a asp-controller="Evidence" asp-action="Download" asp-route-id="@ev.EvidenceId" class="btn btn-sm btn-primary">
                                        ⬇️ Download
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No evidence has been uploaded for this case.</p>
            }
        </div>

        <hr />
        <a asp-action="Index" class="btn btn-secondary">Back to Cases</a>

    </div>


