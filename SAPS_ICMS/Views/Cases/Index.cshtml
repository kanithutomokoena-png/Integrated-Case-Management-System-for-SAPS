@model IEnumerable<SAPS_ICMS.Models.Case>
@{
    ViewData["Title"] = "Cases";
}

    <div style="margin-left:130px; padding:1px 16px; height:1000px;">
        <h2>Cases</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
    
    <a type="submit" asp-action="Create" class="btn btn-primary mb-3">Create New Case</a>
        <br />

        <table>
            <thead>
                <tr >
                    <th>Case ID</th>
                    <th>Complainant</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CaseId</td>
                        <td>@c.Complainant</td>
                        <td>@c.Date</td>
                        <td>@c.Status</td>
                        <td>
                        <a asp-action="Details" asp-route-id="@c.CaseId" class="btn btn-sm btn-info" style="margin-left:5px;">View</a>
                            <hr />
                            @if(User.IsInRole("Detective") && c.Status != CaseStatus.Closed)
                        {
                            <a href="javascript:void(0);" onclick="showEditRequestModal(@c.CaseId)" return false; class="btn btn-sm btn-warning" style="margin-left:5px;">Request Edit</a>
                        }
                    </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>

@Html.AntiForgeryToken()


<div id="editRequestModal" style="display:none; position:fixed; z-index:1000; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.4);">
    <div style="background-color:#fefefe; margin:10% auto; padding:20px; border:1px solid #888; width:500px; border-radius:10px;">
        <h3 id="modalTitle">Request Case Edit</h3>
        <p id="editCaseInfo" style="margin: 15px 0; padding: 10px; background-color: #f9f9f9; border-radius: 5px;"></p>

        <label for="requestedChanges" style="display:block; margin-bottom:5px; font-weight:bold;">Requested Changes: *</label>
        <textarea id="requestedChanges" rows="4" style="width:100%; padding:8px; margin-bottom:15px;" placeholder="Describe what needs to be changed..."></textarea>

        <label for="justification" style="display:block; margin-bottom:5px; font-weight:bold;">Justification:</label>
        <textarea id="justification" rows="3" style="width:100%; padding:8px; margin-bottom:15px;" placeholder="Why is this edit necessary?"></textarea>

        <div style="text-align:right;">
            <button onclick="closeEditRequestModal()" style="padding:8px 16px; margin-right:10px; cursor:pointer;">Cancel</button>
            <button onclick="submitEditRequest()" style="padding:8px 16px; background-color:cornflowerblue; color:white; border:none; cursor:pointer; border-radius:4px;">Submit Request</button>
        </div>
    </div>
</div>

<script>
    let editRequestCaseId = null;

    function showEditRequestModal(caseId, caseTitle) {
        editRequestCaseId = caseId;
        document.getElementById("editRequestModal").style.display = "block";
        document.getElementById("requestedChanges").value = "";
        document.getElementById("justification").value = "";
    }

    function closeEditRequestModal() {
        document.getElementById("editRequestModal").style.display = "none";
        editRequestCaseId = null;
    }

    function submitEditRequest() {
        const requestedChanges = document.getElementById("requestedChanges").value.trim();
        const justification = document.getElementById("justification").value.trim();

        if (!requestedChanges) {
            alert("Please describe the requested changes");
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const formData = new FormData();
        formData.append('CaseId', editRequestCaseId);
        formData.append('RequestedChanges', requestedChanges);
        formData.append('Justification', justification);
        formData.append('__RequestVerificationToken', token);

        fetch('/Pages/RequestCaseEdit', {
            method: 'POST',
            body: formData
        })
        .then(r => {
            if (!r.ok) throw new Error('Network response was not ok');
            return r.json();
        })
        .then(data => {
            if (data.success) {
                alert(data.message);
                closeEditRequestModal();
            } else {
                alert("Error: " + data.message);
            }
        })
        .catch(error => {
            alert("An error occurred: " + error.message);
        });
    }

    window.onclick = function(event) {
        const modal = document.getElementById("editRequestModal");
        if (event.target == modal) {
            closeEditRequestModal();
        }
    }
</script>



